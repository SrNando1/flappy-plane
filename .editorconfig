# Estilo de código do projeto. O formatador do C# (Roslyn) lê este ficheiro,
# tal como o Visual Studio e o Rider: a formatação passa a ser a mesma em
# qualquer editor, em vez de depender das definições de cada máquina.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ficheiros do Unity são YAML e usam 2 espaços
[*.{meta,unity,asset,prefab,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# chavetas na linha de baixo, como o resto do projeto já está escrito
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false

# 'var' quando o tipo já se vê na linha (var music = musicGo.AddComponent...)
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion

# corpos de expressão, como em ToggleMusic e PlayScore
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# campos privados em camelCase sem prefixo: engineOn, musicSource, config
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case
